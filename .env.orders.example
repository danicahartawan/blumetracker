# Never commit the populated .env file. Local mode binds only to 127.0.0.1.
BLUME_AUTH_MODE=local

# Server-side only. Required for PDF order extraction; XLSX import is local and does not use OpenAI.
OPENAI_API_KEY=
OPENAI_ORDER_MODEL=gpt-5.4

NETSUITE_BASE_URL=https://YOUR_ACCOUNT.suitetalk.api.netsuite.com
NETSUITE_ACCESS_TOKEN=
# Optional: override the default read-only SuiteQL query.
# NETSUITE_SUITEQL=SELECT id, tranid FROM transaction WHERE type = 'SalesOrd' ORDER BY trandate DESC

GMAIL_ACCESS_TOKEN=
GMAIL_LABEL_ID=
# Recommended: only process a dedicated label, e.g. label:Blume-Orders
GMAIL_ORDER_QUERY=label:Blume-Orders

TYPEFORM_TOKEN=
TYPEFORM_FORM_ID=
TYPEFORM_WEBHOOK_SECRET=

WRIKE_TOKEN=
WRIKE_FOLDER_ID=
WRIKE_WEBHOOK_SECRET=

# Official STORD MCP gateway. Sign in through STORD/Cloudflare OAuth; never use a guessed REST endpoint.
STORD_MCP_URL=https://gateway.stord.com/mcp
STORD_MCP_ACCESS_TOKEN=
STORD_ORG_ID=
STORD_FACILITY_ID=

# Optional compatibility/reporting connection; not the source of truth.
GOOGLE_ACCESS_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
